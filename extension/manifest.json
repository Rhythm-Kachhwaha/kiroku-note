{
  "manifest_version": 3,
  "name": "Kiroku Note",
  "version": "2.1.0",
  "description": "Local-first Japanese vocabulary mining.",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Open Kiroku Note"
  },
  "permissions": [
    "sidePanel",
    "activeTab",
    "scripting",
    "tabs",
    "clipboardRead",
    "contextMenus"
  ],
  "commands": {
    "open-side-panel": {
      "suggested_key": {
        "default": "Alt+Shift+K"
      },
      "description": "Open Kiroku Note side panel"
    }
  },
  "host_permissions": [
    "http://127.0.0.1:21828/*",
    "*://*.youtube.com/*",
    "*://*.netflix.com/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "lib/subtitle-parser.js",
        "lib/subtitle-provider.js",
        "lib/jimaku-provider.js",
        "lib/image-cropper.js",
        "lib/ocr-cropper.js",
        "content/adapters/youtube-adapter.js",
        "content/adapters/netflix-adapter.js",
        "content/capture-utils.js",
        "content/content.js",
        "content/video-mining/detector.js",
        "content/video-mining/sync.js",
        "content/video-mining/overlay.js",
        "content/video-mining/controls.js",
        "content/video-mining/main.js",
        "content/ocr-selection.js",
        "content/link-bridge.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "content/adapters/youtube-bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/fullscreen-hook.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
