{
  "manifest_version": 3,
  "name": "Kiroku Note",
  "version": "1.0.0",
  "description": "Local-first Japanese vocabulary mining.",
  "permissions": [
    "sidePanel",
    "activeTab",
    "scripting",
    "tabs",
    "tabCapture",
    "offscreen"
  ],
  "host_permissions": [
    "http://127.0.0.1:21828/*",
    "*://*.youtube.com/*",
    "*://*.netflix.com/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "lib/subtitle-parser.js",
        "lib/image-cropper.js",
        "lib/ocr-cropper.js",
        "content/adapters/youtube-adapter.js",
        "content/adapters/netflix-adapter.js",
        "content/capture-utils.js",
        "content/content.js",
        "content/video-mining-poc.js",
        "content/ocr-selection.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "content/adapters/youtube-bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ]
}
