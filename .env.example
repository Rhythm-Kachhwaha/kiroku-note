# =============================================================================
# Kiroku Note — Local Environment Configuration Example
# =============================================================================
# Copy this file to .env and configure local settings or credentials.
# Note: .env is strictly ignored by Git and should never contain production secrets.

# -----------------------------------------------------------------------------
# Core Server & Storage Configuration
# -----------------------------------------------------------------------------
KIROKU_HOST=127.0.0.1
KIROKU_PORT=21828
# KIROKU_DATA_DIR=%LOCALAPPDATA%\KirokuNote
# KIROKU_MEDIA_DIR=%LOCALAPPDATA%\KirokuNote\media
# KIROKU_STUDY_DIR=%LOCALAPPDATA%\KirokuNote\study

# -----------------------------------------------------------------------------
# OCR Server Configuration (Optional)
# -----------------------------------------------------------------------------
DEFAULT_OCR_HOST=127.0.0.1
DEFAULT_OCR_PORT=21829
# KIROKU_OCR_MODEL_PATH=backend/data/models/manga-ocr-base

# -----------------------------------------------------------------------------
# Vocabulary Mining LLM Configuration (Assistant / Chat)
# -----------------------------------------------------------------------------
# KIROKU_LLM_PROVIDER=groq
# KIROKU_LLM_MODEL=openai/gpt-oss-120b
# KIROKU_LLM_API_KEY=your_groq_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here
# KIROKU_LLM_TIMEOUT=45.0

# -----------------------------------------------------------------------------
# Study Bank — Milestone 3 Gate 2 AI Question Verification
# -----------------------------------------------------------------------------
# Enable or disable automated AI verification of JLPT question candidates
KIROKU_AI_ENABLED=true

# Model A Configuration (e.g. xAI / Grok)
KIROKU_AI_MODEL_A_PROVIDER=xai
KIROKU_AI_MODEL_A_MODEL=grok-2
KIROKU_AI_MODEL_A_API_KEY=your_xai_api_key_here
# KIROKU_AI_MODEL_A_BASE_URL=https://api.x.ai/v1

# Model B Configuration (e.g. OpenAI or OpenAI-compatible endpoint)
KIROKU_AI_MODEL_B_PROVIDER=openai_compatible
KIROKU_AI_MODEL_B_MODEL=gpt-4o-mini
KIROKU_AI_MODEL_B_API_KEY=your_openai_or_proxy_api_key_here
# KIROKU_AI_MODEL_B_BASE_URL=https://api.openai.com/v1

# AI Verification Execution Settings
KIROKU_AI_TIMEOUT=60.0
KIROKU_AI_MAX_RETRIES=2
KIROKU_AI_MAX_CONCURRENCY=2

# -----------------------------------------------------------------------------
# Dictionary & Yomitan Secondary Configuration
# -----------------------------------------------------------------------------
# Path to local dictionary SQLite database (overrides default search paths)
# KIROKU_DICT_SQLITE=backend/data/kiroku_dict.sqlite
# Dictionary backend: local (default) | local+yomitan | yomitan | auto
# DICTIONARY_BACKEND=local
# Enable Yomitan as optional secondary source (appends Yomitan entries after local)
# KIROKU_YOMITAN_SECONDARY=false

# -----------------------------------------------------------------------------
# Extension Origin & Pairing Configuration
# -----------------------------------------------------------------------------
# Extension origin policy: allowlist (default) | open
# KIROKU_EXTENSION_ORIGIN_POLICY=allowlist
# Additional development Chrome extension IDs (comma-separated)
# KIROKU_DEV_EXTENSION_IDS=
# Enable extension pairing for WebSocket and link authentication (default: 1)
# KIROKU_EXTENSION_PAIRING_ENABLED=1

# -----------------------------------------------------------------------------
# Legacy Token Mode Configuration
# -----------------------------------------------------------------------------
# Token enforcement mode for legacy/link API endpoints: off | warn | enforce
# KIROKU_LEGACY_TOKEN_MODE=warn


