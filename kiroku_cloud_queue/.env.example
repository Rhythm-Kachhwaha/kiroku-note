# ==============================================================================
# Kiroku Cloud Queue — Environment Variables Template
# ==============================================================================
# Copy this file to .env and configure values before starting services.
# NEVER commit real tokens or credentials into version control.

# ------------------------------------------------------------------------------
# 1. Cloud Authentication & API Tokens
# ------------------------------------------------------------------------------
# Generate strong random tokens:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

# Token used by iPhone Shortcut in Authorization: Bearer <SUBMIT_TOKEN>
SUBMIT_TOKEN=your-iphone-submit-token-here

# Token used by local Windows worker in Authorization: Bearer <WORKER_TOKEN>
WORKER_TOKEN=your-windows-worker-token-here

# Token for ChatGPT MCP client tool calls (can match WORKER_TOKEN or be unique)
MCP_SECRET=your-mcp-secret-token-here

# ------------------------------------------------------------------------------
# 2. Database & Queue Persistence Settings (Server)
# ------------------------------------------------------------------------------
# Storage engine:
#   "sqlite"   - Local file database (default, used for local dev & testing)
#   "postgres" - PostgreSQL connection (recommended for Cloud Run + Supabase)
QUEUE_STORAGE=sqlite

# PostgreSQL Connection URL (e.g. Supabase direct connection string)
# Required only if QUEUE_STORAGE=postgres
# DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres

# Target Anki destination deck for all mined vocabulary
ANKI_DECK_NAME=N3 vocabs

# Cloud API Server port
PORT=8080

# ------------------------------------------------------------------------------
# 3. Local Windows Worker Settings (Runs on PC)
# ------------------------------------------------------------------------------
# Queue backend mode:
#   "local" - Reads from local development SQLite database
#   "cloud" - Connects outbound over HTTPS to your deployed cloud queue API
QUEUE_BACKEND=local

# Public HTTPS URL of your deployed cloud queue service (when QUEUE_BACKEND=cloud)
# Example: https://kiroku-queue-xyz.run.app
CLOUD_QUEUE_URL=

# Worker authentication Bearer token (must match WORKER_TOKEN on server)
CLOUD_QUEUE_API_KEY=

# Local Kiroku backend loopback URL (default: http://127.0.0.1:21828)
KIROKU_URL=http://127.0.0.1:21828

# Worker polling interval in seconds
WORKER_POLL_INTERVAL=10
